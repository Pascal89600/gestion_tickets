{% extends 'base.html.twig' %}

{% block title %}Ajouter une catégorie{% endblock %}

{% block body %}
    <h1>Ajouter une catégorie</h1>

    {{ form_start(form) }}

        {{ form_row(form.nom) }}

        <button type="submit" class="btn btn-primary mt-3">
            Enregistrer
        </button>

    {{ form_end(form) }}
{% endblock %}