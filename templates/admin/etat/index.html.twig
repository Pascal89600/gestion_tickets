{% extends 'base.html.twig' %}

{% block title %}Gestion des états{% endblock %}

{% block body %}
    <h1>Gestion des états</h1>
    <a
        href="{{ path('app_admin_etat_new') }}"
        class="btn btn-primary mb-3"
    >
        Ajouter un état
    </a>
    <table class="table table-striped">
        <thead>
            <tr>
                <th>ID</th>
                <th>Nom</th>
            </tr>
        </thead>
        <tbody>
            {% for etat in etats %}
        
                <tr>
                    <td>{{ etat.id }}</td>
                    <td>{{ etat.nom }}</td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="2" class="text-center">Aucun état disponible</td>
                </tr>
            
            {% endfor %}
        </tbody>
    </table>
{% endblock %}
