{% extends 'base.html.twig' %}

{% block title %}Modifier un état{% endblock %}

{% block body %}
    <h1>Modifier un état</h1>

    {{ form_start(form) }}

        {{ form_row(form.nom) }}
        {{ form_row(form.cloturant) }}

        <button type="submit" class="btn btn-primary mt-3">
            Enregistrer
        </button>
        <a
            href="{{ path('app_admin_etat_index') }}"
            class="btn btn-primary mt-3 "
        >
            Retour
        </a>

    {{ form_end(form) }}
{% endblock %}