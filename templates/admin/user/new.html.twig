{% extends 'base.html.twig' %}
{% block title %}Ajouter un utilisateur{% endblock %}

{% block body %}
    <h1>Ajouter un utilisateur</h1>

    {{ form_start(form) }}

        {{ form_row(form.prenom) }}
        {{ form_row(form.nom) }}
        {{ form_row(form.email) }}
        {{ form_row(form.roles) }}
        {{ form_row(form.plainPassword) }}

        <button type="submit" class="btn btn-primary mt-3">
            Enregistrer
        </button>

    {{ form_end(form) }}
{% endblock %}