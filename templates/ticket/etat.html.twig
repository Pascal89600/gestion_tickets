{% extends 'base.html.twig' %}

{% block title %}Modifier l'état du ticket{% endblock %}

{% block body %}

<h1 class="mb-4">
    Modifier l'état du ticket n°{{ ticket.id }}
</h1>

<div class="card shadow-sm">
    <div class="card-body">

        <p>
            <strong>Client :</strong> {{ ticket.email }}
        </p>

        <p>
            <strong>État actuel :</strong> {{ ticket.etat.nom }}
        </p>

        {{ form_start(form) }}

            {{ form_row(form.etat) }}

            <button type="submit" class="btn btn-primary">
                Enregistrer
            </button>

            <a href="{{ path('app_ticket_show', {'id': ticket.id}) }}"
               class="btn btn-secondary">
                Annuler
            </a>

        {{ form_end(form) }}

    </div>
</div>

{% endblock %}