{% extends 'base.html.twig' %}

{% block title %}Liste des tickets{% endblock %}

{% block body %}

<h1 class="mb-4">Liste des tickets</h1>

<div class="card shadow-sm">
    <div class="card-body">

        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">

                <thead class="table-dark">
                    <tr>
                        <th>ID</th>
                        <th>Client</th>
                        <th>Catégorie</th>
                        <th>État</th>
                        <th>Responsable</th>
                        <th>Date d'ouverture</th>
                    </tr>
                </thead>

                <tbody>
                    {% for ticket in tickets %}
                        <tr>
                            <td>{{ ticket.id }}</td>
                            <td>{{ ticket.email }}</td>
                            <td>{{ ticket.categorie.nom }}</td>
                            <td>{{ ticket.etat.nom }}</td>

                            <td>
                                {% if ticket.responsable %}
                                    {{ ticket.responsable.prenom }}
                                    {{ ticket.responsable.nom }}
                                {% else %}
                                    <span class="text-muted">Non attribué</span>
                                {% endif %}
                            </td>

                            <td>
                                {{ ticket.dateOuverture|date('d/m/Y H:i', 'Europe/Paris') }}
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="6" class="text-center text-muted">
                                Aucun ticket enregistré.
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>

            </table>
        </div>

    </div>
</div>

{% endblock %}